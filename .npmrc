# サプライチェーン対策(docs/security.md)
save-exact=true
engine-strict=true
# 公開から7日未満の版は入れない(自分たちのパッケージは除く)
min-release-age=7
min-release-age-exclude=@entertainment-design-catalog/*
# インストールスクリプトは package.json の allowScripts で許可したものだけ(npm approve-scripts で管理)
strict-allow-scripts=true
# git から直接入れる依存を禁止する
allow-git=none
